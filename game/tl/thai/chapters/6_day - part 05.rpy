# game/chapters/6_day.rpy:9
translate thai day6cont2_e988acfb:

    # player "Tell me, maybe I can help."
    player "บอก​ฉัน​สิ บางที​ฉัน​อาจ​ช่วย​ได้​นะ"

# game/chapters/6_day.rpy:984
translate thai day6cont2_734f9969:

    # GR "then answer the call, and we can discuss it."
    GR "งั้น​ก็​รับสาย​มา​สิ แล้ว​เรา​จะ​ได้​คุย​กัน"

# game/chapters/6_day.rpy:1013
translate thai call1_day6_8dd6f6fd:

    # GRC "Hey."
    GRC "เฮ้ย"

# game/chapters/6_day.rpy:1027
translate thai call1_day6_63fe1d27:

    # GRC "To put it bluntly..."
    GRC "พูดตรงๆ เลย​ก็​คือ..."

# game/chapters/6_day.rpy:1041
translate thai call1_day6_29d871b3:

    # GRC "I think it's because of you."
    GRC "ข้า​คิด​ว่า​มัน​เป็น​เพราะ​เจ้า​น่ะ"

# game/chapters/6_day.rpy:1046
translate thai call1_day6_1d43774a:

    # GRC "The soul sickness I'm experiencing."
    GRC "อาการป่วย​วิญญาณ​ที่​ข้า​กำลัง​เจอ​อยู่​น่ะ"

# game/chapters/6_day.rpy:1048
translate thai call1_day6_a2286ee8:

    # GRC "I've gotten it much more since I've known you."
    GRC "ข้า​เป็นมัน​บ่อย​ขึ้น​มาก​ตั้งแต่​รู้จัก​เจ้า​เลย​ล่ะ"

# game/chapters/6_day.rpy:1067
translate thai call1_day6_376bec71:

    # GRC "I didn't know it tasted like that."
    GRC "ข้า​ไม่​เคย​รู้​เลย​ว่า​มัน​มี​รสชาติ​แบบ​นั้น"

# game/chapters/6_day.rpy:1073
translate thai call1_day6_83961024:

    # GRC "Sarcasm tastes almost sour!"
    GRC "การประชด​มี​รสเปรี้ยว​เกือบจะ​เปรี้ยว​เลย​นะ!"

# game/chapters/6_day.rpy:1083
translate thai call1_day6_bb3d91ca:

    # GRC "No, that's not what I mean at all."
    GRC "ไม่ ข้า​ไม่​ได้​หมายถึง​แบบ​นั้น​เลย​สักนิด"

# game/chapters/6_day.rpy:1086
translate thai call1_day6_7e49df93:

    # GRC "Yes, it is from souls."
    GRC "ใช่ มัน​มาจาก​วิญญาณ​น่ะ"

# game/chapters/6_day.rpy:1087
translate thai call1_day6_d0d8dbc1:

    # GRC "Yet I've suffered from it regardless."
    GRC "แต่​ข้า​ก็​ยัง​ทนทุกข์​จาก​มัน​อยู่ดี"

# game/chapters/6_day.rpy:1100
translate thai call1_day6_11a6b232:

    # GRC "I don't think it is."
    GRC "ข้า​ไม่​คิด​ว่า​เป็น​แบบ​นั้น​หรอก"

# game/chapters/6_day.rpy:1101
translate thai call1_day6_37fe566f:

    # GRC "Not anymore, anyway."
    GRC "ไม่​ใช่​อีกต่อไป​แล้ว​ล่ะ"

# game/chapters/6_day.rpy:1106
translate thai call1_day6_8e48816c:

    # GRC "I'm not saying you are the cause of the sickness."
    GRC "ข้า​ไม่​ได้​บอ​กว่า​เจ้า​เป็นต้นเหตุ​ของ​อาการป่วย​นะ"

# game/chapters/6_day.rpy:1108
translate thai call1_day6_56061d7b:

    # GRC "But I do think you are the cause of why I seem to be more susceptible to it."
    GRC "แต่​ข้า​คิด​จริงๆ นะ​ว่า​เจ้า​คือ​สาเหตุ​ที่​ทำให้​ข้า​ดูเหมือน​จะ​รับ​มัน​ง่าย​ขึ้น"

# game/chapters/6_day.rpy:1120
translate thai call1_day6_07ef532f:

    # GRC "No, my soul was unbalanced before I came to you."
    GRC "ไม่ วิญญาณ​ข้า​ไม่​สมดุล​มา​ก่อนที่​ข้า​จะ​มาหา​เจ้า​แล้ว"

# game/chapters/6_day.rpy:1130
translate thai call1_day6_ef08d970:

    # GRC "I came to you to see if it would go away."
    GRC "ข้า​มาหา​เจ้า​เพื่อ​ดู​ว่า​มัน​จะ​หาย​ไป​มั้ย​น่ะ"

# game/chapters/6_day.rpy:1133
translate thai call1_day6_af010449:

    # GRC "That was my theory."
    GRC "นั่น​คือ​ทฤษฎี​ของ​ข้า"

# game/chapters/6_day.rpy:1143
translate thai call1_day6_1d0cb8d2:

    # GRC "But it did."
    GRC "แต่​มัน​หาย​ไป​จริงๆ นะ"

# game/chapters/6_day.rpy:1145
translate thai call1_day6_f09eb977:

    # GRC "Sunshine, it did."
    GRC "ซัน​ไช​น์ มัน​หาย​ไป​จริงๆ นะ"

# game/chapters/6_day.rpy:1150
translate thai call1_day6_ee383ccc:

    # GRC "You didn't do it on purpose, then?"
    GRC "งั้น​เจ้า​ไม่​ได้​ตั้งใจ​ทำ​มัน​เหรอ?"

# game/chapters/6_day.rpy:1152
translate thai call1_day6_499956f6:

    # GRC "Do you have any clue what you're doing?"
    GRC "เจ้า​รู้​บ้าง​มั้ย​ว่า​ตัวเอง​กำลัง​ทำ​อะไร​อยู่​น่ะ?"

# game/chapters/6_day.rpy:1158
translate thai call1_day6_008afe10:

    # GRC "..."
    GRC "..."

# game/chapters/6_day.rpy:1167
translate thai call1_day6_0f835f8e:

    # GRC "It's your soul."
    GRC "มัน​คือ​วิญญาณ​ของ​เจ้า​น่ะ"

# game/chapters/6_day.rpy:1169
translate thai call1_day6_3e955a32:

    # GRC "You're... giving it away, so to speak."
    GRC "เจ้า​กำลัง... แจก​มัน​ออก​ไป พูด​ง่ายๆ ก็​คือ​แบบ​นั้น​น่ะ"

# game/chapters/6_day.rpy:1182
translate thai call1_day6_9afc2da2:

    # GRC "Do you ever wish, mortal?"
    GRC "เจ้า​เคย​อธิษฐาน​มั้ย มนุษย์?"

# game/chapters/6_day.rpy:1183
translate thai call1_day6_b5d00da6:

    # GRC "Feel something so strongly, want for something so badly?"
    GRC "รู้สึก​ถึง​บางอย่าง​อย่าง​แรงกล้า อยากได้​บางอย่าง​มาก​จน​แทบ​ทนไม่ไหว​น่ะ?"

# game/chapters/6_day.rpy:1197
translate thai call1_day6_a96aa9cf:

    # GRC "You said that your pet was ill yesterday, correct?"
    GRC "เจ้า​บอ​กว่า​สัตว์เลี้ยง​ของ​เจ้า​ป่วย​เมื่อวาน​นี้ ใช่​มั้ย?"

# game/chapters/6_day.rpy:1199
translate thai call1_day6_484758fc:

    # GRC "And now they are fine, yes?"
    GRC "แล้ว​ตอนนี้​มัน​ก็​โอเค​แล้ว ใช่​มั้ย?"

# game/chapters/6_day.rpy:1203
translate thai call1_day6_0d904be4:

    # GRC "I think you did it then, as well."
    GRC "ข้า​คิด​ว่า​ตอนนั้น​เจ้า​ก็​ทำ​มัน​เหมือนกัน​น่ะ​แหละ"

# game/chapters/6_day.rpy:1205
translate thai call1_day6_25b35c03:

    # GRC "You are giving parts of yourself away."
    GRC "เจ้า​กำลัง​แจก​ส่วนหนึ่ง​ของ​ตัวเอง​ออก​ไป​น่ะ"

# game/chapters/6_day.rpy:1206
translate thai call1_day6_4853852f:

    # GRC "To your sick pet."
    GRC "ให้​กับ​สัตว์เลี้ยง​ที่​ป่วย​ของ​เจ้า"

# game/chapters/6_day.rpy:1208
translate thai call1_day6_c68e5604:

    # GRC "To your plant."
    GRC "ให้​กับ​ต้นไม้​ของ​เจ้า"

# game/chapters/6_day.rpy:1210
translate thai call1_day6_dfd5c67d:

    # GRC "To me."
    GRC "ให้​กับ​ข้า"

# game/chapters/6_day.rpy:1211
translate thai call1_day6_118236ad:

    # GRC "Things you want to be healthy."
    GRC "สิ่ง​ที่​เจ้า​อยาก​ให้​แข็งแรง​น่ะ"

# game/chapters/6_day.rpy:1212
translate thai call1_day6_f43659df:

    # GRC "Things you want to live."
    GRC "สิ่ง​ที่​เจ้า​อยาก​ให้​มีชีวิตรอด​น่ะ"

# game/chapters/6_day.rpy:1217
translate thai call1_day6_6f089762:

    # GRC "I think you are taking the taint away... or maybe neutralizing it. I don't know."
    GRC "ข้า​คิด​ว่า​เจ้า​กำลัง​ลบ​การ​ปนเปื้อน​ออก​ไป... หรือ​อาจจะ​ทำให้​มัน​เป็นกลาง ข้า​ไม่​รู้​หรอก"

# game/chapters/6_day.rpy:1219
translate thai call1_day6_6e33f2a2:

    # GRC "I got an even better look at your soul when I visited you."
    GRC "ตอนที่​ข้า​ไปหา​เจ้า ข้า​ได้​เห็น​วิญญาณ​ของ​เจ้า​ชัด​ขึ้นไป​อีก​นะ"

# game/chapters/6_day.rpy:1221
translate thai call1_day6_df561057:

    # GRC "I understand the pulsing now. It's because you do not have a full soul."
    GRC "ตอนนี้​ข้า​เข้าใจ​การ​เต้น​ของ​มัน​แล้ว​ล่ะ มัน​เพราะ​วิญญาณ​เจ้า​ไม่​เต็มดวง​น่ะ"

# game/chapters/6_day.rpy:1230
translate thai call1_day6_40d5b81f:

    # GRC "I have... never seen a soul that is not full..."
    GRC "ข้า... ไม่​เคย​เห็น​วิญญาณ​ที่​ไม่​เต็มดวง​มา​ก่อน​เลย..."

# game/chapters/6_day.rpy:1232
translate thai call1_day6_f9da1ad6:

    # GRC "So I cannot answer your question."
    GRC "เพราะ​งั้น​ข้า​เลย​ตอบคำถาม​เจ้า​ไม่​ได้​หรอก"

# game/chapters/6_day.rpy:1237
translate thai call1_day6_85918f43:

    # GRC "But if you were to give it all away...."
    GRC "แต่​ถ้า​เจ้า​แจก​มัน​ออก​ไป​จน​หมด...."

# game/chapters/6_day.rpy:1239
translate thai call1_day6_e4a86eea:

    # GRC "Well, I assume you would just... simply cease to be."
    GRC "ก็​นะ ข้า​ว่า​เจ้า​คงจะ... สูญสลาย​ไป​เลย​น่ะ"

# game/chapters/6_day.rpy:1246
translate thai call1_day6_008afe10_1:

    # GRC "..."
    GRC "..."

# game/chapters/6_day.rpy:1247
translate thai call1_day6_65122790:

    # GRC "I..."
    GRC "ข้า..."

# game/chapters/6_day.rpy:1253
translate thai call1_day6_1e30d68b:

    # GRC "I would never forget. You. Our time together."
    GRC "ข้า​จะ​ไม่​มี​วัน​ลืม เจ้า เวลา​ที่​เรา​อยู่​ด้วยกัน ข้า​จะ​ไม่​ลืม​เลย"

# game/chapters/6_day.rpy:1254
translate thai call1_day6_2b8ab6e4:

    # GRC "So... maybe try to be careful."
    GRC "เพราะ​งั้น... อาจจะ​ลอง​ระวังตัว​หน่อย​ก็ดี​นะ"

# game/chapters/6_day.rpy:1255
translate thai call1_day6_8d7a3fbb:

    # GRC "Don't wish too hard is all I'm saying."
    GRC "ข้า​แค่​จะ​บอ​กว่า​อย่า​อธิษฐาน​หนัก​เกินไป​น่ะ แค่​นั้นแหละ"

# game/chapters/6_day.rpy:1266
translate thai call1_day6_02c09232:

    # GRC "Uh."
    GRC "เอ่อ"

# game/chapters/6_day.rpy:1267
translate thai call1_day6_2be91614:

    # GRC "I don't really know if that's how this works."
    GRC "ข้า​ไม่​รู้​จริงๆ หรอ​กว่า​มัน​ทำงาน​แบบ​นั้น​มั้ย"

# game/chapters/6_day.rpy:1269
translate thai call1_day6_35bcad1c:

    # GRC "But if it makes you feel better Sunshine, sure."
    GRC "แต่​ถ้า​มัน​ทำให้​เจ้า​รู้สึก​ดีขึ้น ซัน​ไช​น์ ก็​เอาเถอะ"

# game/chapters/6_day.rpy:1277
translate thai call1_day6_8baf5f41:

    # GRC "Good."
    GRC "ดี"

# game/chapters/6_day.rpy:1278
translate thai call1_day6_8d1e18ec:

    # GRC "I would expect no less from you."
    GRC "ข้า​ก็​ไม่​ได้​คาดหวัง​อะไร​น้อยกว่า​นั้น​จาก​เจ้า​หรอก"

# game/chapters/6_day.rpy:1286
translate thai call1_day6_04e5a69d:

    # GRC "I'm sure it won't come to that. I've survived all this time on my own."
    GRC "ข้า​มั่นใจ​ว่า​มัน​จะ​ไม่​ถึงขั้น​นั้น​หรอก ข้า​รอด​มา​ได้​ตลอด​เวลานี้​ด้วยตัวเอง​นะ"

# game/chapters/6_day.rpy:1288
translate thai call1_day6_94c82b72:

    # GRC "You don't need to overly concern yourself with my health."
    GRC "เจ้า​ไม่​จำเป็นต้อง​เป็นห่วง​สุขภาพ​ข้า​มากเกินไป​หรอก​นะ"

# game/chapters/6_day.rpy:1290
translate thai call1_day6_aa2421a7:

    # GRC "Anyway, aren't you supposed to be focused on keeping your soul and not giving it away?"
    GRC "ว่าแต่ เจ้า​ไม่​ควรจะ​โฟกัส​ที่​การ​เก็บ​วิญญาณ​ตัวเอง​ไว้​และ​ไม่​แจก​มัน​ออก​ไป​เหรอ?"

# game/chapters/6_day.rpy:1291
translate thai call1_day6_ae00afe6:

    # GRC "Focus on our bet. Focus on trying to take my soul."
    GRC "โฟกัส​ที่​เดิมพัน​ของ​เรา​สิ โฟกัส​ที่​การ​พยายาม​เอา​วิญญาณ​ข้า​ไป​สิ"

# game/chapters/6_day.rpy:1305
translate thai call1_day6_27736588:

    # GRC "I do like your confidence, my little mortal."
    GRC "ข้า​ชอบ​ความมั่นใจ​ของ​เจ้า​นะ มนุษย์​น้อย​ของ​ข้า"

# game/chapters/6_day.rpy:1306
translate thai call1_day6_fe588614:

    # GRC "We'll see how long that holds up."
    GRC "เรา​มา​ดู​กัน​ว่า​มัน​จะ​คงอยู่​ได้​นาน​แค่​ไหน"

# game/chapters/6_day.rpy:1320
translate thai call1_day6_da78e520:

    # GRC "I don't really think that would be a good idea."
    GRC "ข้า​ไม่​คิด​ว่า​มัน​จะ​เป็น​ความคิด​ที่​ดี​สัก​เท่าไหร่​นะ"

# game/chapters/6_day.rpy:1321
translate thai call1_day6_4fcc199f:

    # GRC "This is obviously something you cannot control."
    GRC "นี่​มัน​เป็นเรื่อง​ที่​เจ้า​ควบคุม​ไม่​ได้​ชัด​ๆ เลย​นะ"

# game/chapters/6_day.rpy:1323
translate thai call1_day6_d75a76e2:

    # GRC "You could take on more than your body could deal with."
    GRC "เจ้า​อาจ​รับ​มัน​มาก​เกิน​กว่า​ที่​ร่างกาย​เจ้า​จะ​รับ​ไหว​ก็ได้​นะ"

# game/chapters/6_day.rpy:1327
translate thai call1_day6_f6f8be8d:

    # GRC "That is not something that can be taught. At least, not by me..."
    GRC "นั่น​ไม่​ใช่​สิ่ง​ที่​สอน​กัน​ได้​หรอก อย่าง​น้อย​ก็​ไม่​ใช่​โดย​ข้า​น่ะ..."

# game/chapters/6_day.rpy:1329
translate thai call1_day6_ec5d32be:

    # GRC "I don't understand how it's even possible. I've never met someone with your abilities."
    GRC "ข้า​ไม่​เข้าใจ​เลย​ว่า​มัน​เป็นไปได้​ยังไง ข้า​ไม่​เคย​เจอ​ใคร​ที่​มี​ความสามารถ​แบบ​เจ้า​มา​ก่อน​เลย"

# game/chapters/6_day.rpy:1331
translate thai call1_day6_92e9bf40:

    # GRC "How or why you're able to do what you can... I cannot even guess."
    GRC "เจ้า​ทำ​สิ่ง​ที่​ทำได้​ยังไง​หรือ​เพราะอะไร... ข้า​เดา​ไม่​ออก​เลย​ด้วยซ้ำ"

# game/chapters/6_day.rpy:1346
translate thai call1_day6_cf43eb42:

    # GRC "...You can do whatever you wish."
    GRC "...เจ้า​อยาก​ทำ​อะไร​ก็​ทำ​เถอะ"

# game/chapters/6_day.rpy:1348
translate thai call1_day6_2e81d297:

    # GRC "You are aware I am trying to take your soul, right?"
    GRC "เจ้า​รู้ตัว​อยู่​ใช่​มั้ย​ว่า​ข้า​กำลัง​พยายาม​เอา​วิญญาณ​เจ้า​อยู่​น่ะ?"

# game/chapters/6_day.rpy:1355
translate thai call1_day6_1bad71ea:

    # GRC "And yet you still... you're such a confusing mortal."
    GRC "แล้ว​เจ้า​ก็​ยัง... เจ้า​นี่​เป็น​มนุษย์​ที่​น่า​สับสน​จริงๆ เลย​นะ"

# game/chapters/6_day.rpy:1356
translate thai call1_day6_25eec6b4:

    # GRC "Fine."
    GRC "เอา​ก็ได้"

# game/chapters/6_day.rpy:1358
translate thai call1_day6_6cfb4d49:

    # GRC "But if you take it too far, you'll..."
    GRC "แต่​ถ้า​เจ้า​ทำ​มัน​เกิน​ขีดจำกัด​ไป เจ้า​จะ..."

# game/chapters/6_day.rpy:1369
translate thai call1_day6_78d4d036:

    # GRC "I wouldn't expect any less, Sunshine."
    GRC "ข้า​ก็​ไม่​ได้​คาดหวัง​อะไร​น้อยกว่า​นั้น​เลย​ล่ะ ซัน​ไช​น์"

# game/chapters/6_day.rpy:1377
translate thai call1_day6_d52325f2:

    # GRC "You can try to... alleviate it, if you truly wish."
    GRC "เจ้า​ลอง... บรรเทา​มัน​ได้​นะ ถ้า​เจ้า​อยาก​ทำ​จริงๆ น่ะ"

# game/chapters/6_day.rpy:1378
translate thai call1_day6_4dc50001:

    # GRC "As long as I can keep an eye on you, it should be fine."
    GRC "ตราบใดที่​ข้า​ยัง​คอย​เฝ้าดู​เจ้า​ได้ มัน​ก็​น่าจะ​ไม่เป็นไร​หรอก"

# game/chapters/6_day.rpy:1380
translate thai call1_day6_1f2fab6b:

    # GRC "Wouldn't want you to get too corrupted, after all."
    GRC "ยังไง​ข้า​ก็​ไม่​อยาก​ให้​เจ้า​เสื่อมเสีย​มากเกินไป​น่ะ"

# game/chapters/6_day.rpy:1389
translate thai call1_day6_07ab7154:

    # GRC "...What?"
    GRC "...ว่า​ไง​นะ?"

# game/chapters/6_day.rpy:1405
translate thai call1_day6_b54bb891:

    # GRC "And this bucket list of yours involves MARRIAGE?"
    GRC "แล้ว bucket list ของ​เจ้า​น่ะ​เกี่ยวข้อง​กับ​การ​แต่งงาน​งั้น​เหรอ?!"

# game/chapters/6_day.rpy:1419
translate thai call1_day6_0bac6bac:

    # GRC "......."
    GRC "......."

# game/chapters/6_day.rpy:1421
translate thai call1_day6_b8c4edfa:

    # GRC "It... you... ugh...!"
    GRC "มัน... เจ้า... อ๊ากกก...!"

# game/chapters/6_day.rpy:1422
translate thai call1_day6_f1e08086:

    # GRC "We're talking about something serious, you know..."
    GRC "เรา​กำลัง​คุย​เรื่อง​จริงจัง​กัน​อยู่​นะ รู้​มั้ย..."

# game/chapters/6_day.rpy:1423
translate thai call1_day6_5b1469e6:

    # GRC "And then you start spouting nonsense about marriage..."
    GRC "แล้ว​เจ้า​ก็​เริ่ม​พูด​เรื่องไร้สาระ​เรื่อง​แต่งงาน​ขึ้น​มา..."

# game/chapters/6_day.rpy:1429
translate thai call1_day6_d1cec93b:

    # GRC "........."
    GRC "........."

# game/chapters/6_day.rpy:1430
translate thai call1_day6_3c6970ed:

    # GRC "Let's... let's worry about your soul for now, and working out why you are how you are..."
    GRC "มา... มา​เป็นห่วง​เรื่อง​วิญญาณ​เจ้า​กัน​ก่อน​เถอะ แล้วก็​หา​คำตอบ​ว่า​ทำไม​เจ้า​ถึง​เป็น​แบบ​ที่​เจ้า​เป็น​น่ะ..."

# game/chapters/6_day.rpy:1431
translate thai call1_day6_34e31ad2:

    # GRC "Marriage... ahem, we can... talk about it later..."
    GRC "เรื่อง​แต่งงาน... ค่ำ เรา... ค่อย​คุย​กัน​ทีหลัง​ก็ได้..."

# game/chapters/6_day.rpy:1447
translate thai call1_day6_96753f4b:

    # GRC "I'm glad you're taking this seriously."
    GRC "ข้า​ดีใจ​ที่​เจ้า​เอาจริงเอาจัง​กับ​เรื่อง​นี้​นะ"

# game/chapters/6_day.rpy:1455
translate thai call1_day6_a1fb91e2:

    # GRC "Some reapers are not miserable. Like me."
    GRC "ยมทูต​บาง​ตน​ก็​ไม่​ได้​ทุกข์ทรมาน​หรอก​นะ อย่าง​ข้า​ไง"

# game/chapters/6_day.rpy:1467
translate thai call1_day6_32302918:

    # GRC "You? Serious?"
    GRC "เจ้า​น่ะ​เหรอ? จริงจัง​น่ะ?"

# game/chapters/6_day.rpy:1468
translate thai call1_day6_4a58c5ce:

    # GRC "Is that possible for you?"
    GRC "เจ้า​ทำได้​ด้วย​เหรอ​เรื่อง​แบบ​นั้น?"

# game/chapters/6_day.rpy:1478
translate thai call1_day6_b66116ea:

    # GRC "I don't know."
    GRC "ข้า​ไม่​รู้​หรอก"

# game/chapters/6_day.rpy:1480
translate thai call1_day6_6bcbebae:

    # GRC "This is not a common thing to happen."
    GRC "นี่​ไม่​ใช่​เรื่อง​ที่​เกิดขึ้น​บ่อยๆ หรอก​นะ"

# game/chapters/6_day.rpy:1482
translate thai call1_day6_84693ec3:

    # GRC "In fact it's so uncommon I'd say you are the first."
    GRC "ที่จริง​มัน​หา​ยากจน​ข้า​พูด​ได้​เลย​ว่า​เจ้า​เป็นราย​แรก​นะ"

# game/chapters/6_day.rpy:1491
translate thai call1_day6_8c9198d1:

    # GRC "I have no tips to give you. This is unprecedented."
    GRC "ข้า​ไม่​มี​เคล็ดลับ​จะ​ให้​เจ้า​หรอก เรื่อง​แบบนี้​ไม่​เคย​เกิดขึ้น​มา​ก่อน​เลย​นะ"

# game/chapters/6_day.rpy:1492
translate thai call1_day6_04400948:

    # GRC "Just... stop wishing and hoping to heal people."
    GRC "ก็​แค่... หยุด​อธิษฐาน​แล้วก็​หยุด​หวัง​จะ​รักษา​คนอื่น​ซะ"

# game/chapters/6_day.rpy:1493
translate thai call1_day6_b931dbb8:

    # GRC "And we'll see what happens from there."
    GRC "แล้ว​เรา​ค่อย​มา​ดู​กัน​ว่า​จะ​เกิด​อะไร​ขึ้น​ต่อจากนั้น"

# game/chapters/6_day.rpy:1495
translate thai call1_day6_98a5ed77:

    # GRC "Keep that magic healing for your pet, perhaps. I know you care deeply about the creature."
    GRC "เก็บ​เวท​รักษา​นั่น​ไว้​ให้​สัตว์เลี้ยง​เจ้า​เถอะ​นะ ข้า​รู้​ว่า​เจ้า​ห่วงใย​เจ้าตัว​นั่น​มาก​จริงๆ"

# game/chapters/6_day.rpy:1506
translate thai call1_day6_4e9b8f30:

    # GRC "I bet I am."
    GRC "ข้า​ว่า​ข้า​ก็​น่าจะ​อยู่​ตรง​นั้นแหละ​นะ"

# game/chapters/6_day.rpy:1507
translate thai call1_day6_7b676143:

    # GRC "Go on, tell me. Is it my charm? My looks? My fashion sense?"
    GRC "เอา​สิ บอก​ข้า​มา เพราะ​เสน่ห์​ข้า​เหรอ? หน้าตา​ข้า​เหรอ? หรือ​เซนส์​การ​แต่งตัว​ของ​ข้า​ล่ะ?"

# game/chapters/6_day.rpy:1518
translate thai call1_day6_a280de5a:

    # GRC "You."
    GRC "เจ้า​ไง"

# game/chapters/6_day.rpy:1538
translate thai call1_day6_eeb77df2:

    # GRC "Excuse me?"
    GRC "ว่า​ไง​นะ?"

# game/chapters/6_day.rpy:1542
translate thai call1_day6_0dfa6290:

    # GRC "I have not heard of it."
    GRC "ข้า​ไม่​เคย​ได้ยิน​มัน​เลย"
