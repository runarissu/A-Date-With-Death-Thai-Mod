# game/chapters/3_day.rpy:1381
translate thai call2_day3_502f3300:

    # GRC "Maybe we'll find out together."
    GRC "บางที​เรา​อาจจะ​ได้​รู้​ไป​พร้อมกัน"

# game/chapters/3_day.rpy:1384
translate thai call2_day3_457b73e6:

    # GRC "Good. This is the start of a... partnership between the two of us."
