    # GRC "[playerfirstname]."
    GRC "[playerfirstname]"

# game/chapters/3_day.rpy:1658
translate thai call2_day3_66d15173:

    # GRC "Stop it, immediately!"
    GRC "หยุด​เดี๋ยวนี้​เลย!"

# game/chapters/3_day.rpy:1659
translate thai call2_day3_48020b0b:

    # GRC "If you do this, then everything will be lost. Everything."
    GRC "ถ้า​เจ้า​ทำ​แบบนี้ ทุกอย่าง​จะ​สูญสิ้น​ไป ทุกอย่าง​เลย"

# game/chapters/3_day.rpy:1668
translate thai call2_day3_3109da83:

    # GRC "Listen to me. Hear my words clearly."
