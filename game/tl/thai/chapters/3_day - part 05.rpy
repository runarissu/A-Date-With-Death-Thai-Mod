# game/chapters/3_day.rpy:1511
translate thai call2_day3_8baf5f41_1:

    # GRC "Good."
    GRC "ดี"

# game/chapters/3_day.rpy:1512
translate thai call2_day3_536114c8:

    # GRC "Make sure you do."
    GRC "ทำให้​มั่นใจ​นะ"

