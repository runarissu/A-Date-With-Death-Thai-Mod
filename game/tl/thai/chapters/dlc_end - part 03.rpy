# game/chapters/dlc_end.rpy:919
translate thai chat2_daydlcend_26ed4fd7:

    # "You hear a knock at the door, and swing it open quickly."
    "คุณ​ได้ยิน​เสียงเคาะ​ประตู แล้ว​รีบ​เปิด​มัน​ออก​อย่าง​รวดเร็ว"

# game/chapters/dlc_end.rpy:920
translate thai chat2_daydlcend_08847dae:

    # "There you see the prettiest, sweetest, stupidest, dumbest man you have ever met."
