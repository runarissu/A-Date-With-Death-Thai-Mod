translate thai call1_day2_8da23161:

    # GRC "...."
    GRC "...."

# game/chapters/2_day.rpy:2643
translate thai call1_day2_0a3780a6:

    # GRC "I see very little mortals. I have near no one to compare you to."
    GRC "ข้า​เห็น​มนุษย์​น้อย​มาก แทบ​ไม่​มี​ใคร​ให้​เปรียบเทียบ​เจ้า​ด้วย​เลย"

# game/chapters/2_day.rpy:2647
