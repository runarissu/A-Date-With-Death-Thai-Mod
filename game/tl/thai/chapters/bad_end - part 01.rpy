# game/chapters/bad_end.rpy:278
translate thai day7_start_badend_c498bcf3:

    # player "I tried to help [pet_name] again, too."
    player "ฉัน​ลอง​ช่วย[pet_name]อี​กรอบ​ด้วย​นะ"

# game/chapters/bad_end.rpy:280
translate thai day7_start_badend_5d758716:

    # GR "you tried again? that quickly?!"
    GR "เจ้า​ลอง​อีกแล้ว​เหรอ? เร็ว​ขนาด​นั้น​เลย?!"

# game/chapters/bad_end.rpy:283
